FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=sqlite:///../data/orion.db

# LLM: use 'mock' without external calls or 'groq' for the real provider.
LLM_PROVIDER=mock
LLM_TIMEOUT_SECONDS=60
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.6-27b
# GROQ_API_KEY=cole_sua_chave_apenas_no_arquivo_.env_local

# Initial RAG retrieval. Embeddings will replace the lexical retriever later.
RAG_TOP_K=5
