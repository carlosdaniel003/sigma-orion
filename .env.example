FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=sqlite:///../data/orion.db

# LLM
# mock       = sem LLM; SQL + SQLite/FTS5/BM25 continuam funcionando.
# llama-cpp  = Qwen local servido pelo llama-server.exe em localhost.
# groq       = provider externo opcional.
LLM_PROVIDER=mock
LLM_TIMEOUT_SECONDS=180

# llama.cpp local / OpenAI-compatible
LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_LLM_HEALTH_URL=http://127.0.0.1:8080/health
LOCAL_LLM_MODEL=orion-qwen
LOCAL_LLM_MAX_TOKENS=800
LOCAL_LLM_TEMPERATURE=0.1
LOCAL_LLM_HEALTH_TIMEOUT_SECONDS=1.0

# Groq continua disponível como alternativa, mas não é necessário para o modo local.
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.6-27b
# GROQ_API_KEY=cole_sua_chave_apenas_no_arquivo_.env_local

# Retrieval atual: SQLite FTS5 + BM25.
RAG_TOP_K=5
